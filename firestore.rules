rules_version = '2';

// Partage+ n'utilise Firestore que pour les compteurs d'appels IA
// (collection ai_usage), écrits uniquement par les Cloud Functions via le SDK
// Admin, qui ignore ces règles. Aucun accès direct depuis l'application.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
