rules_version = '2';

// Firestore contient les compteurs d'appels IA (collection ai_usage, écrits
// par les Cloud Functions) et une copie des offres MySQL (collection offers,
// écrite par le serveur). Tous deux passent par le SDK Admin, qui ignore ces
// règles. Aucun accès direct depuis l'application.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
