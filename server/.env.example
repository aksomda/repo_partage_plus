# Copier ce fichier en .env puis adapter les valeurs.

PORT=3000
NODE_ENV=development

# Option 1 : URL complète (Railway, Aiven…). Prioritaire si renseignée.
# DATABASE_URL=mysql://user:motdepasse@hote:3306/repas_partage
# Mettre à true si l'hébergeur MySQL impose TLS (Aiven, PlanetScale…).
DB_SSL=false

# Option 2 : paramètres séparés (MySQL local de WAMP)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=repas_partage

# MySQL d'un serveur distant qui n'écoute que sur sa propre machine : le
# serveur ouvre lui-même un tunnel SSH (DB_HOST et DB_PORT sont alors vus
# depuis ce serveur, en général 127.0.0.1 et 3306). Vide : connexion directe.
SSH_TUNNEL_HOST=
SSH_TUNNEL_PORT=22
SSH_TUNNEL_USER=ubuntu
# Clé privée (.pem), hors du dépôt.
SSH_TUNNEL_KEY=
# Port local du tunnel (WAMP occupe déjà 3306 pour MySQL et 3307 pour MariaDB).
SSH_TUNNEL_LOCAL_PORT=13306

# Obligatoire en production : 32 caractères aléatoires minimum, ex.
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-moi
JWT_EXPIRES_IN=7d

# Origines autorisées (séparées par des virgules), * pour tout autoriser.
# En production : l'adresse de l'application web uniquement.
CORS_ORIGINS=*

# Proxys de confiance devant le serveur (adresse IP réelle du client).
# Vide : 1 en production (Render), aucun sinon. false si exposé directement.
TRUST_PROXY=

# Limites de débit par adresse IP (ou par compte). off pour les couper.
RATE_LIMIT=
RATE_LIMIT_PER_MINUTE=300
# Inscription, codes, mot de passe oublié : requêtes par quart d'heure.
RATE_LIMIT_AUTH_PER_15_MINUTES=30

# Tâches planifiées (rappels de retrait, DLC proche, expiration).
JOBS_INTERVAL_MINUTES=15
# Jeton pour déclencher les tâches depuis un cron externe (POST /api/jobs/run).
JOBS_TOKEN=

# Position autour de laquelle sont créées les offres de démo (db:seed).
SEED_LAT=12.3714
SEED_LNG=-1.5197

# Firebase Auth (voir docs/FIREBASE.md).
# L'identifiant suffit pour vérifier les connexions ; le compte de service
# permet en plus de désactiver les comptes et de copier les offres dans
# Firestore. Valeur : chemin du fichier .json téléchargé depuis la console
# Firebase (le plus simple, hors du dépôt), JSON brut sur une ligne, ou base64.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT=C:/chemin/vers/partageplus-firebase-adminsdk.json

# Copie des offres dans Firestore (collection offers, id = id MySQL).
# Active dès que FIREBASE_SERVICE_ACCOUNT est renseigné ; false pour couper.
# Offres déjà enregistrées : npm run firestore:sync
FIRESTORE_MIRROR=
FIRESTORE_DATABASE_ID=(default)

# Envoi des e-mails par Firebase : extension « Trigger Email from Firestore »
# installée sur le projet (collection surveillée : MAIL_COLLECTION).
# MAIL_TRANSPORT=firebase ; sinon SMTP ci-dessous. Avec Firebase, SMTP sert
# de secours s'il est rempli.
MAIL_TRANSPORT=
MAIL_COLLECTION=mail

# Envoi des codes d'activation. Sans SMTP_HOST (hors production),
# le code est affiché dans la console du serveur.
# Gmail : SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true,
# SMTP_USER=votre adresse Gmail, SMTP_PASSWORD=mot de passe d'application
# (16 caractères, https://myaccount.google.com/apppasswords, validation en
# 2 étapes requise), jamais le mot de passe du compte.
# Port 587 : SMTP_SECURE=false (STARTTLS imposé par le serveur).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Partage+ <a.ksomda@gmail.com>
# Adresse qui reçoit les réponses aux e-mails (facultatif).
MAIL_REPLY_TO=
# Durée de validité du code, en minutes.
OTP_TTL_MINUTES=10

# IA de recommandation intégrée au serveur (repli de la Cloud Function :
# Windows, Linux, Firebase non configuré). Clé RodiumAI rd_sk_… (secrète).
RODIUM_API_KEY=
RODIUM_MODEL=openai/gpt-4o-mini
# Appels à l'IA par heure et par utilisateur (ou par adresse IP sans compte).
AI_CALLS_PER_HOUR=30

# SMS des codes d'activation et de mot de passe oublié, EN PLUS de l'e-mail,
# seulement si le compte a un numéro. Vide : pas de SMS.
# android-gateway : application « SMS Gateway for Android » (https://sms-gate.app)
# installée sur un téléphone avec carte SIM ; les SMS partent de ce numéro.
SMS_PROVIDER=
# Mode cloud (par défaut) : https://api.sms-gate.app/3rdparty/v1/messages
# Mode local (même Wi-Fi que le serveur) : http://<ip-du-téléphone>:8080/message
SMS_GATEWAY_URL=
# Identifiant et mot de passe affichés dans l'application du téléphone.
SMS_GATEWAY_USERNAME=
SMS_GATEWAY_PASSWORD=
# Nombre maximal de SMS par jour (tous comptes confondus).
SMS_DAILY_LIMIT=10
# Indicatif ajouté aux numéros saisis sans indicatif.
SMS_DEFAULT_COUNTRY_CODE=+226

# Recherche à la voix (écran Recommandations) : retranscription (Whisper) et
# filtrage des offres (gpt-oss, modèle ouvert) par une IA ouverte, API compatible OpenAI.
# Groq (gratuit) : créez une clé sur https://console.groq.com/keys (gsk_…).
GROQ_API_KEY=
# Autre service compatible (facultatif) : ex. Ollama en local
# VOICE_AI_BASE_URL=http://localhost:11434/v1 (filtrage seulement, pas d'audio).
VOICE_AI_BASE_URL=https://api.groq.com/openai/v1
VOICE_AI_STT_MODEL=whisper-large-v3-turbo
VOICE_AI_LLM_MODEL=openai/gpt-oss-120b
VOICE_AI_LABEL=Groq
