{
  "name": "repas-partage-api",
  "version": "1.0.0",
  "description": "API REST de Repas Partage Plus (Express + MySQL)",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/db/migrate.js && node src/server.js",
    "dev": "node src/db/migrate.js && node --watch src/server.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "firestore:sync": "node src/db/firestore_sync.js",
    "start:prod": "node src/db/migrate.js && node src/server.js",
    "test": "node --test --test-concurrency=1"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "cors": "2.8.6",
    "dotenv": "18.0.3",
    "express": "5.2.1",
    "firebase-admin": "14.5.0",
    "jsonwebtoken": "9.0.3",
    "mysql2": "3.24.4",
    "nodemailer": "10.0.12",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "supertest": "7.3.0"
  }
}
